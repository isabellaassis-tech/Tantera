# Desenvolvimento local: deixe DATABASE_URL vazio para usar data/tantera-db.json.
# Produção: use a connection string pooled do Neon como segredo do Render.
DATABASE_URL=
DATABASE_SSL=true

# Cria a primeira conta somente se ainda não existir no banco.
TANTERA_ADMIN_NAME=Presidência Tantera
TANTERA_ADMIN_EMAIL=
TANTERA_ADMIN_PASSWORD=

# Migra o arquivo local para um banco Neon vazio uma única vez.
MIGRATE_LOCAL_DB=true

# Mercado Pago Checkout Transparente com Orders (ambiente de teste)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Mantenha false em produção; true habilita apenas a rota fictícia oficial APRO.
MP_TEST_MODE=false
MP_TEST_SECRET=
